# Cloud Run service configuration. Never put these values in the Vite frontend.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
LOOP_ALLOWED_ORIGINS=http://localhost:5173,https://your-firebase-hosting-domain.web.app
GEMINI_API_KEY=your_server_only_gemini_api_key
# Latest high-capability Pro model. Change to a stable model when needed.
GEMINI_MODEL=gemini-3.5-flash
# Automatic Gmail intake mailbox. Keep all values in Cloud Run/Secret Manager.
# Messages forwarded to intake+<organizationId>@your-domain are parsed on sync.
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_INTAKE_REFRESH_TOKEN=your_intake_mailbox_refresh_token
GMAIL_SYNC_KEY=long_random_scheduler_secret
# On Cloud Run use Application Default Credentials. Locally, optionally set:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
