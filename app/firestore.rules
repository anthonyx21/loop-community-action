rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(organizationId) { return signedIn() && exists(/databases/$(database)/documents/organizations/$(organizationId)/members/$(request.auth.uid)); }
    match /organizations/{organizationId} {
      allow read: if member(organizationId);
      allow write: if false;
      match /{document=**} { allow read: if member(organizationId); allow write: if false; }
    }
  }
}
