# LOOP — Google service configuration
# Copy this file to .env.local for local development. Do not commit .env.local.
#
# All values below are required. The UI shows a configuration error until these
# Google services are connected.

# Gemini is configured only in backend/.env (GEMINI_API_KEY). Never expose it
# through a VITE_ variable because Vite embeds those values in the browser.

# Google Maps Platform
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
VITE_GOOGLE_MAP_ID=your_google_map_id_optional

# Firebase Web App (Authentication, Firestore, Storage and Hosting)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id_optional

# Google Identity / Firebase Authentication (optional for Google sign-in)
VITE_GOOGLE_CLIENT_ID=your-oauth-web-client-id.apps.googleusercontent.com

# Google Cloud Run service that owns secure server-side Gemini and workflow calls.
# Browser code should call this service; do not expose server-only keys in Vite.
VITE_LOOP_API_BASE_URL=https://your-cloud-run-service-<hash>-uc.a.run.app
VITE_LOOP_ORGANIZATION_ID=your-firestore-organization-id

# Deployment and project metadata
VITE_GOOGLE_CLOUD_PROJECT_ID=your-google-cloud-project-id
